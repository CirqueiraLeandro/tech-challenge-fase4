              "type": "color-background"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "window",
            "rowField": "feature",
            "valueField": "Value"
          }
        }
      ]
    }
  ],
  "templating": {
