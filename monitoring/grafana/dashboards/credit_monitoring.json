      }
    },
    {
      "id": 11,
      "title": "11. Heatmap PSI feature x janela",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Verde < 0,10 estável; laranja 0,10-0,20 moderado; vermelho >= 0,20 severo.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "credit_feature_psi",
          "legendFormat": "",
          "format": "table",
          "instant": true,
