ENVIRONMENT=development
RANDOM_SEED=42
LOG_LEVEL=INFO
MODEL_TYPE=xgboost
MIN_AUC=0.75
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Vazio = desligado (privacy by default)
PUSHGATEWAY_URL=
ALERT_WEBHOOK_URL=
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYMIZATION_KEY=troque-por-uma-chave-secreta
RETENTION_RAW_DAYS=3650
RETENTION_QUARANTINE_DAYS=30
RETENTION_LOGS_DAYS=90
